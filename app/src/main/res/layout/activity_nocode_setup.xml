<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:id="@+id/nocode_logo"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="18dp"
        android:contentDescription="@string/application_name"
        android:src="@drawable/nocode_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/nocode_setup_title"
        android:textColor="#F5F2E6"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nocode_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/nocode_status_idle"
        android:textColor="#B0B0B0"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/nocode_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="#9CE826"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/nocode_percent_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0%"
        android:textColor="#9CE826"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/nocode_buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/nocode_configure_auto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#9CE826"
            android:text="@string/nocode_configure_auto"
            android:textColor="#000000"
            android:textStyle="bold" />

        <Button
            android:id="@+id/nocode_configure_manual"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#1A1A1A"
            android:text="@string/nocode_configure_manual"
            android:textColor="#F5F2E6" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/nocode_log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="#0D0D0D"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/nocode_log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#8A8A8A"
            android:textIsSelectable="true"
            android:textSize="10sp" />

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nocode_build_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#4A4A4A"
            android:textSize="10sp" />

        <Button
            android:id="@+id/nocode_log_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#1A1A1A"
            android:minWidth="0dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/nocode_show_log"
            android:textColor="#B0B0B0"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
