<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/nocode_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/nocode_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:contentDescription="@string/application_name"
            android:src="@drawable/nocode_logo" />

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:indeterminateTint="#9CE826" />

        <TextView
            android:id="@+id/nocode_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/nocode_starting_opencode"
            android:textColor="#B0B0B0"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/nocode_error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/nocode_error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/nocode_web_error"
                android:textColor="#F5F2E6"
                android:textSize="15sp" />

            <Button
                android:id="@+id/nocode_retry_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="#9CE826"
                android:text="@string/nocode_retry"
                android:textColor="#000000" />

            <Button
                android:id="@+id/nocode_error_browser_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#2A2A2A"
                android:text="@string/nocode_open_in_browser"
                android:textColor="#F5F2E6" />

            <Button
                android:id="@+id/nocode_error_copy_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#2A2A2A"
                android:text="@string/nocode_copy_diagnostics"
                android:textColor="#F5F2E6" />

            <Button
                android:id="@+id/nocode_error_terminal_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1A1A1A"
                android:text="@string/nocode_go_to_terminal"
                android:textColor="#F5F2E6" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
